# Copy to .env and fill values
PINECONE_API_KEY=
PINECONE_ENV_CLOUD=aws
PINECONE_ENV_REGION=us-east-1

# Embedding/device
DEVICE=mps  # options: cuda, mps, cpu
DIMENSION=1536  # can be 1536, 1024, 768, 512, etc. (Matryoshka truncation)

# Defaults
INDEX_NAME=vdr-images
NAMESPACE=default
SCREENSHOTS_DIR=./screenshots
